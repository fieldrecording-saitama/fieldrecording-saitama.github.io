---
import type { CollectionEntry } from "astro:content";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  notes: CollectionEntry<"notes">[];
  moreHref?: string;
}
const { notes, moreHref } = Astro.props;
---

<section class="section notes-section" aria-labelledby="notes-title">
  <SectionHeading kicker="Listening Notes" compact>
    <h2 id="notes-title">聴くための短い記録</h2>
  </SectionHeading>
  <div class="notes-grid">
    {
      notes.map((note) => (
        <p>
          <a href={`/notes/${note.id}/`}>{note.data.excerpt}</a>
        </p>
      ))
    }
  </div>
  {
    moreHref && (
      <p class="notes-more">
        <a href={moreHref}>記録の一覧を見る</a>
      </p>
    )
  }
</section>

<style>
.notes-grid p {
  margin: 0;
  color: var(--ink-muted);
}

.notes-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  border: 1px solid var(--line);
  background: var(--line);
}

.notes-grid p {
  min-height: 180px;
  padding: 30px;
  background: var(--white);
  font-size: 1.1rem;
}

@media (max-width: 720px) {
  .notes-grid {
    grid-template-columns: 1fr;

  }
}
</style>

<style>
  .notes-grid a {
    color: inherit;
    text-decoration: none;
  }

  .notes-grid a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .notes-more {
    margin-top: 18px;
    padding-inline: 0;
  }

  .notes-more a {
    color: var(--green);
    font-weight: 600;
  }
</style>
