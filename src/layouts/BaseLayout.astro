---
import "../styles/global.css";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="さいたまの音風景を記録し、共有するフィールドレコーディングクラブさいたま。音地図や今後のワークショップ、成果展示の情報を紹介します。">
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href="https://fieldrecording-saitama.github.io/">
    <meta property="og:site_name" content="フィールドレコーディングクラブさいたま">
    <meta property="og:title" content="フィールドレコーディングクラブさいたま">
    <meta property="og:description" content="さいたまの音風景を記録し、共有する市民クラブ。音地図や今後の活動情報を紹介します。">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://fieldrecording-saitama.github.io/">
    <meta property="og:image" content="https://fieldrecording-saitama.github.io/assets/img/ogp-fieldrecording-saitama.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="フィールドレコーディングクラブさいたま公式HPのOGP画像">
    <meta property="og:locale" content="ja_JP">
