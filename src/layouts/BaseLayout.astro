                "addressLocality": "さいたま市大宮区",
                "addressRegion": "埼玉県",
                "addressCountry": "JP"
              }
            },
            "organizer": {
              "@id": "https://fieldrecording-saitama.github.io/#organization"
            },
            "performer": [
              {
                "@type": "Organization",
                "name": "Field Recording Club, Saitama"
              },
              {
                "@type": "Person",
                "name": "Minuma / Nukumori Eugene"
              }
            ]
          },
          {
            "@type": "Event",
            "@id": "https://fieldrecording-saitama.github.io/#field-recording-workshop-2026-09",
            "name": "フィールドレコーディングワークショップ「出会い：聞き手、テクニック、場所（Encounters: Listener, Technique, Location)」",
            "description": "作曲家・サウンドアーティスト Paulo Dantasを迎え、さいたまのまちを歩きながら音風景を聴き、録音した2日間のワークショップです。",
            "startDate": "2026-09-05T16:00:00+09:00",
            "endDate": "2026-09-06T20:00:00+09:00",
            "eventStatus": "https://schema.org/EventCompleted",
            "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
            "url": "https://fieldrecording-saitama.github.io/#workshop",
            "image": [
              "https://cdn.peatix.com/event/5117510/cover-CebE30B6mHNbkqeXjr9I094p4DOzKdAd.png"
            ],
            "maximumAttendeeCapacity": 14,
            "inLanguage": "ja",
            "location": {
              "@type": "Place",
              "name": "まちラボおおみや / URBAN DESIGN CENTER OMIYA (15:30 開場・受付開始）",
              "address": {
                "@type": "PostalAddress",
                "streetAddress": "宮町１丁目６０大宮ラクーン8F",
                "addressLocality": "さいたま市大宮区",
                "addressRegion": "埼玉県",
                "addressCountry": "JP"
              }
            },
            "organizer": {
              "@id": "https://fieldrecording-saitama.github.io/#organization"
