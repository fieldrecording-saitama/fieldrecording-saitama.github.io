---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { withBase } from "../../lib/url";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const dateFormat = new Intl.DateTimeFormat("ja-JP", { dateStyle: "long" });
---

<BaseLayout
  title="聴くための記録"
  description="フィールドレコーディングクラブさいたまが書き留めた、さいたまの音風景をめぐる短い記録と活動レポート。"
>
  <main class="page-main">
    <section class="section">
      <SectionHeading kicker="Listening Notes" title="聴くための記録">
        <p>まちを歩きながら書き留めた、音にまつわる短い記録です。</p>
      </SectionHeading>
    </section>

    <section class="section muted">
      <div class="note-list">
        {
          notes.map((note) => (
            <article>
              <time datetime={note.data.date.toISOString().slice(0, 10)}>
                {dateFormat.format(note.data.date)}
              </time>
              <h3><a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a></h3>
              <p>{note.data.excerpt}</p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .note-list {
    display: grid;
    gap: 22px;
  }

  .note-list article {
    display: grid;
    gap: 6px;
    padding: 22px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .note-list time {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .note-list h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .note-list h3 a {
    color: inherit;
    text-decoration: none;
  }

  .note-list h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .note-list p {
    margin: 0;
    color: var(--ink-muted);
    line-height: 1.8;
  }
</style>
